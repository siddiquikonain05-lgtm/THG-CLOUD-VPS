# Copy these into Railway -> Variables. NEVER commit real values.
TERMINAL_USER=change-me
TERMINAL_PASSWORD=use-a-long-random-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
DATA_DIR=/data
# Railway sets PORT automatically; only set it for local runs.
PORT=8000

# Optional limits
# MAX_UPLOAD_MB=512
# MAX_EXTRACT_MB=2048
# MAX_LOG_MB=50
# SESSION_HOURS=72
