#!/usr/bin/env python3
"""thgjob - start/inspect detached background jobs from inside the web terminal.

  thgjob run python app.py        run in the background (survives closing the browser)
  thgjob list                     show jobs
  thgjob logs 3 [-f] [--err]      show a job's output
  thgjob stop 3 | restart 3 | rm 3
"""
import argparse
import os
import shlex
import sys
import time

sys.path.insert(0, os.environ.get("THG_APP_ROOT", os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")))
from app import config, database, process_manager as pm  # noqa: E402


def fmt(job):
    end = job["ended_at"] or time.time()
    rt = int(end - job["started_at"])
    code = "-" if job["exit_code"] is None else job["exit_code"]
    return f"{job['id']:>4}  {job['status']:<11} pid={job['pid'] or '-':<7} exit={code:<4} {rt:>6}s  {job['command']}"


def main():
    ap = argparse.ArgumentParser(prog="thgjob")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("-C", "--cwd", default=os.getcwd())
    r.add_argument("command", nargs=argparse.REMAINDER)
    sub.add_parser("list")
    for name in ("stop", "restart", "rm"):
        sub.add_parser(name).add_argument("id", type=int)
    lg = sub.add_parser("logs")
    lg.add_argument("id", type=int)
    lg.add_argument("-f", "--follow", action="store_true")
    lg.add_argument("--err", action="store_true", help="show stderr instead of stdout")
    a = ap.parse_args()
    database.init()
    try:
        if a.cmd == "run":
            cmd = a.command[1:] if a.command[:1] == ["--"] else a.command
            if not cmd:
                ap.error("nothing to run")
            job = pm.start_job(" ".join(shlex.quote(c) for c in cmd), a.cwd, reap=False)
            print(f"started job {job['id']} (pid {job['pid']}) in {job['cwd']}")
            print(f"  view: thgjob logs {job['id']} -f   stop: thgjob stop {job['id']}")
        elif a.cmd == "list":
            for j in reversed(pm.list_jobs(50)):
                print(fmt(j))
        elif a.cmd == "stop":
            print(fmt(pm.stop_job(a.id)))
        elif a.cmd == "restart":
            print(fmt(pm.restart_job(a.id)))
        elif a.cmd == "rm":
            pm.delete_job(a.id)
            print("deleted history of job", a.id)
        elif a.cmd == "logs":
            stream = "stderr" if a.err else "stdout"
            off = -1
            while True:
                chunk = pm.read_log(a.id, stream, off, 65536)
                sys.stdout.write(chunk["data"])
                sys.stdout.flush()
                off = chunk["next_offset"]
                if off < chunk["size"]:
                    continue
                if not a.follow:
                    break
                job = pm.refresh_job(pm.get_job(a.id))
                if job is None or job["status"] != "RUNNING":
                    chunk = pm.read_log(a.id, stream, off, 65536)
                    sys.stdout.write(chunk["data"])
                    break
                time.sleep(0.5)
    except (pm.JobError, KeyboardInterrupt) as exc:
        print(exc if str(exc) else "", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
